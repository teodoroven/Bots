# Storage backend
STORAGE_BACKEND=sql
DATABASE_ECHO=0

# Токены Telegram/VK-ботов и API-ключи GPT - реальные секреты.
# Проект хранит конфигурации ботов и GPT-настройки через storage/admin UI,
# поэтому не добавляйте реальные токены или пользовательские данные в этот файл.

# Local SQLite, safe default for development on Windows and Linux.
DATABASE_URL=sqlite:///autocenter_bot.db

# PostgreSQL via separate fields. Prefer this for Docker/server setups
# when you do not want the password to be embedded into DATABASE_URL.
# DATABASE_URL=
# DATABASE_DRIVER=postgresql+psycopg
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=autocenter_bot
# DATABASE_USER=autocenter_bot_user
# DATABASE_PASSWORD=replace-with-local-password
# DATABASE_PASSWORD_FILE=
